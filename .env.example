# ==========================================
# CONNECTOR MODULE ENVIRONMENT CONFIGURATION
# ==========================================

# General Application Settings
ENVIRONMENT=development
LOG_LEVEL=INFO

# ------------------------------------------
# Microsoft Teams Integration
# ------------------------------------------
# Option A: Incoming Webhook URL (For sending notifications)
TEAMS_WEBHOOK_URL=https://outlook.office.com/webhook/your-webhook-id-here

# Option B: Azure AD / Microsoft Graph Credentials (For Graph API actions)
TEAMS_CLIENT_ID=00000000-0000-0000-0000-000000000000
TEAMS_CLIENT_SECRET=your_teams_azure_secret
TEAMS_TENANT_ID=00000000-0000-0000-0000-000000000000

# ------------------------------------------
# Atlassian Jira Integration
# ------------------------------------------
# Method A: OAuth 2.0 (3LO) [Recommended for Multi-User Cloud]
# Obtain credentials from https://developer.atlassian.com/console/myapps/
JIRA_CLIENT_ID=your_atlassian_oauth_client_id
JIRA_CLIENT_SECRET=your_atlassian_oauth_client_secret
JIRA_REDIRECT_URI=http://localhost:8000/auth/jira/callback

# Method B: API Token (Direct Service Account fallback)
JIRA_SERVER_URL=https://your-domain.atlassian.net
JIRA_USER_EMAIL=user@company.com
JIRA_API_TOKEN=your_jira_api_token
JIRA_DEFAULT_PROJECT_KEY=PROJ

# ------------------------------------------
# Microsoft SharePoint Integration
# ------------------------------------------
SHAREPOINT_SITE_URL=https://yourtenant.sharepoint.com/sites/YourSite
SHAREPOINT_TENANT_ID=00000000-0000-0000-0000-000000000000
SHAREPOINT_CLIENT_ID=00000000-0000-0000-0000-000000000000
SHAREPOINT_CLIENT_SECRET=your_sharepoint_azure_secret
SHAREPOINT_DOCUMENT_LIBRARY=Shared Documents

# ------------------------------------------
# AppMiner Neo4j Database Integration
# ------------------------------------------
NEO4J_URI=neo4j+s://your-instance.databases.neo4j.io
NEO4J_USERNAME=neo4j
NEO4J_PASSWORD=your_neo4j_password
NEO4J_DATABASE=neo4j

