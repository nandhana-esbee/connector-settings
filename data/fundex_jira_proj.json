  "crossProjectConventions": [
    {
      "item": "Project",
      "recommendedConvention": "One Jira project per application/domain: FINX, ICICI, CLENS."
    },
    {
      "item": "Epic",
      "recommendedConvention": "Major application capability or end-to-end business area."
    },
    {
      "item": "Story",
      "recommendedConvention": "A user-visible capability or workflow step supported by the source context."
    },
    {
      "item": "Task",
      "recommendedConvention": "Technical work required to implement a story, where needed."
    },
    {
      "item": "Bug",
      "recommendedConvention": "Observed defect or mismatch between expected and actual application behavior."
    },
    {
      "item": "Spike",
      "recommendedConvention": "Investigation where requirements or implementation details are not established by the source."
    },
    {
      "item": "Acceptance Criteria",
      "recommendedConvention": "Derive from the stated goal/flow and explicitly separate confirmed behavior from assumptions."
    }
  ],
  "suggestedWorkflow": [
